/* =========================
   CONFIGURAÇÕES GERAIS
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    background: #f4f0e8;
    color: #20201d;
    font-family: "DM Sans", sans-serif;
    line-height: 1.6;
}

img {
    width: 100%;
    display: block;
}

a {
    color: inherit;
    text-decoration: none;
}


/* =========================
   CABEÇALHO
========================= */

.header {
    width: 100%;
    padding: 28px 6%;
    display: flex;
    justify-content: space-between;
    align-items: center;

    position: sticky;
    top: 0;
    z-index: 100;

    background: rgba(244, 240, 232, 0.94);
    backdrop-filter: blur(10px);

    border-bottom: 1px solid rgba(32, 32, 29, 0.12);
}

.logo {
    font-size: 17px;
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: 1px;
}

.nav {
    display: flex;
    gap: 35px;
}

.nav a {
    font-size: 14px;
    position: relative;
}

.nav a::after {
    content: "";
    width: 0;
    height: 1px;

    position: absolute;
    bottom: -5px;
    left: 0;

    background: #c95c32;

    transition: 0.3s;
}

.nav a:hover::after {
    width: 100%;
}

.menu-btn {
    display: none;
    border: none;
    background: transparent;
    font-size: 25px;
    cursor: pointer;
}


/* =========================
   HERO
========================= */

.hero {
    min-height: 90vh;
    padding: 80px 6%;

    display: grid;
    grid-template-columns: 1fr 0.8fr;
    gap: 8%;

    align-items: center;
}

.hero-text {
    max-width: 700px;
}

.small-title {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    margin-bottom: 25px;
}

.hero h1 {
    font-family: "Playfair Display", serif;
    font-size: clamp(65px, 9vw, 130px);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -5px;
}

.hero h1 span {
    display: block;
    color: #c95c32;
}

.hero-description {
    max-width: 450px;
    margin-top: 40px;

    font-size: 17px;
    color: #55544e;
}

.main-button {
    display: inline-flex;
    gap: 25px;
    align-items: center;

    margin-top: 35px;
    padding: 15px 22px;

    background: #c95c32;
    color: white;

    font-size: 14px;
    font-weight: 700;

    transition: 0.3s;
}

.main-button:hover {
    transform: translateY(-4px);
    background: #a94723;
}

.main-button span {
    font-size: 18px;
}


/* FOTO PRINCIPAL */

.hero-image {
    position: relative;
    max-width: 500px;
    justify-self: end;
}

.hero-image img {
    height: 650px;
    object-fit: cover;
    filter: grayscale(8%);
}

.image-label {
    position: absolute;
    z-index: 2;

    top: 20px;
    left: -25px;

    padding: 10px 15px;

    background: #20201d;
    color: white;

    font-size: 11px;
    letter-spacing: 2px;
}


/* =========================
   SEÇÕES
========================= */

.section {
    padding: 140px 6%;
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 40px;

    border-top: 1px solid rgba(32, 32, 29, 0.15);
}

.section-number {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    color: #77756e;
}

.about-content,
.projects-content,
.skills-content,
.contact-content {
    max-width: 1100px;
}

.section h2 {
    max-width: 900px;

    font-family: "Playfair Display", serif;
    font-size: clamp(45px, 6vw, 85px);

    font-weight: 500;
    line-height: 1;
    letter-spacing: -3px;

    margin-bottom: 60px;
}

.section h2 em {
    color: #c95c32;
    font-style: normal;
}

.about-content > p:not(.small-title) {
    max-width: 750px;
    font-size: 20px;
    color: #55544e;
    margin-bottom: 20px;
}


/* =========================
   FRASE
========================= */

.statement {
    min-height: 60vh;

    padding: 100px 8%;

    display: flex;
    justify-content: center;
    align-items: center;

    background: #20201d;
    color: #f4f0e8;
}

.statement p {
    max-width: 1000px;

    text-align: center;

    font-family: "Playfair Display", serif;
    font-size: clamp(45px, 7vw, 100px);

    line-height: 1;
}


/* =========================
   PROJETOS
========================= */

.project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.project-card {
    min-height: 300px;

    padding: 35px;

    border: 1px solid rgba(32, 32, 29, 0.2);

    display: flex;
    flex-direction: column;
    justify-content: space-between;

    transition: 0.3s;
}

.project-card:hover {
    background: #20201d;
    color: #f4f0e8;
    transform: translateY(-7px);
}

.project-card span {
    font-size: 12px;
    color: #c95c32;
    font-weight: 700;
}

.project-card h3 {
    font-family: "Playfair Display", serif;
    font-size: 30px;
    font-weight: 500;
}

.project-card p {
    color: #77756e;
}

.project-card:hover p {
    color: #c9c6bd;
}


/* =========================
   GASTRONOMIA
========================= */

.gastronomy-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8%;

    align-items: center;
}

.gastronomy-image img {
    height: 600px;
    object-fit: cover;
}

.gastronomy-text {
    max-width: 550px;
}

.gastronomy-text h2 {
    margin-bottom: 35px;
}

.gastronomy-text p:not(.small-title) {
    color: #55544e;
    font-size: 18px;
    margin-bottom: 20px;
}


/* =========================
   HABILIDADES
========================= */

.skills-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
}

.skills-list div {
    padding: 30px 0;

    border-top: 1px solid rgba(32, 32, 29, 0.2);

    font-family: "Playfair Display", serif;
    font-size: 28px;
}


/* =========================
   CONTATO
========================= */

.contact {
    min-height: 80vh;
    align-items: center;
}

.contact-content > p:not(.small-title) {
    max-width: 600px;
    color: #55544e;
    font-size: 18px;
}


/* =========================
   RODAPÉ
========================= */

footer {
    padding: 60px 6%;

    background: #20201d;
    color: #f4f0e8;

    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    align-items: center;

    border-top: 5px solid #c95c32;
}

.footer-name {
    font-family: "Playfair Display", serif;
    font-size: 25px;
}

.footer-info {
    text-align: center;
    font-size: 14px;
}

.footer-copy {
    text-align: right;
    font-size: 13px;
    color: #aaa79f;
}


/* =========================
   RESPONSIVIDADE
========================= */

@media (max-width: 900px) {

    .nav {
        display: none;

        position: absolute;
        top: 80px;
        left: 0;

        width: 100%;

        padding: 30px;

        background: #f4f0e8;

        flex-direction: column;
        text-align: center;
    }

    .nav.active {
        display: flex;
    }

    .menu-btn {
        display: block;
    }

    .hero {
        grid-template-columns: 1fr;
        padding-top: 60px;
    }

    .hero-image {
        justify-self: center;
        width: 100%;
    }

    .hero-image img {
        height: 500px;
    }

    .section {
        grid-template-columns: 1fr;
        gap: 25px;
    }

    .project-grid {
        grid-template-columns: 1fr;
    }

    .gastronomy-content {
        grid-template-columns: 1fr;
    }

    .gastronomy-image img {
        height: 450px;
    }

    .skills-list {
        grid-template-columns: 1fr 1fr;
    }

    footer {
        grid-template-columns: 1fr;
        gap: 20px;
        text-align: center;
    }

    .footer-info,
    .footer-copy {
        text-align: center;
    }
}


@media (max-width: 600px) {

    .header {
        padding: 22px 5%;
    }

    .hero {
        padding: 50px 5%;
    }

    .hero h1 {
        font-size: 65px;
        letter-spacing: -3px;
    }

    .hero-description {
        font-size: 16px;
    }

    .section {
        padding: 90px 5%;
    }

    .section h2 {
        font-size: 50px;
        letter-spacing: -2px;
    }

    .statement {
        min-height: 45vh;
        padding: 70px 5%;
    }

    .statement p {
        font-size: 48px;
    }

    .skills-list {
        grid-template-columns: 1fr;
    }

    .gastronomy-image img {
        height: 350px;
    }
}