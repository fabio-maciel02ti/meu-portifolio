/* =========================================
   VARIÁVEIS
========================================= */

:root {

    /* 60% - cor dominante */
    --fundo: #f5f7fa;
    --branco: #ffffff;

    /* 30% - cor secundária */
    --azul-escuro: #123c69;
    --azul: #1d5f9e;

    /* 10% - cor de destaque */
    --destaque: #f28c28;

    --texto: #172033;
    --texto-suave: #59687a;
    --borda: #e1e6ec;

    --sombra: 0 15px 40px rgba(18, 60, 105, 0.10);
}


/* =========================================
   RESET
========================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


html {
    scroll-behavior: smooth;
}


body {
    font-family: "Roboto", sans-serif;
    background: var(--fundo);
    color: var(--texto);
    line-height: 1.6;
}


h1,
h2,
h3 {
    font-family: "Poppins", sans-serif;
}


a {
    text-decoration: none;
}


/* =========================================
   CABEÇALHO
========================================= */

.header {

    position: sticky;
    top: 0;

    z-index: 1000;

    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 20px 8%;

    background: rgba(255, 255, 255, 0.97);

    border-bottom: 1px solid var(--borda);
}


.logo {

    font-family: "Poppins", sans-serif;

    font-size: 28px;

    font-weight: 700;

    color: var(--azul-escuro);
}


.logo span {
    color: var(--destaque);
}


.menu {

    display: flex;

    gap: 28px;
}


.menu a {

    color: var(--texto);

    font-weight: 500;

    transition: 0.3s;
}


.menu a:hover {
    color: var(--azul);
}


/* =========================================
   HERO
========================================= */

.hero {

    min-height: 88vh;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 60px;

    padding: 80px 10%;
}


.hero-conteudo {
    max-width: 650px;
}


.saudacao {

    color: var(--azul);

    font-size: 14px;

    font-weight: 700;

    letter-spacing: 3px;

    margin-bottom: 10px;
}


.hero h1 {

    font-size: clamp(48px, 7vw, 78px);

    line-height: 1.1;

    margin-bottom: 10px;
}


.hero h1 span {
    color: var(--azul);
}


.hero h2 {

    font-size: 28px;

    color: var(--texto-suave);

    margin-bottom: 20px;
}


.hero-texto {

    max-width: 600px;

    font-size: 18px;

    color: var(--texto-suave);
}


/* =========================================
   BOTÕES
========================================= */

.hero-botoes,
.contato-botoes {

    display: flex;

    gap: 15px;

    margin-top: 30px;

    flex-wrap: wrap;
}


.botao {

    display: inline-block;

    padding: 13px 25px;

    border-radius: 8px;

    font-weight: 600;

    transition: 0.3s;
}


/* Botão principal */

.botao-destaque {

    background: var(--destaque);

    color: #ffffff;
}


.botao-destaque:hover {

    transform: translateY(-3px);

    filter: brightness(0.92);
}


/* Botão secundário */

.botao-outline {

    border: 2px solid var(--azul-escuro);

    color: var(--azul-escuro);

    background: transparent;
}


.botao-outline:hover {

    background: var(--azul-escuro);

    color: #ffffff;
}


/* =========================================
   FOTO DE PERFIL
========================================= */

.perfil-card {

    width: 340px;

    padding: 18px;

    background: var(--branco);

    border: 1px solid var(--borda);

    border-radius: 20px;

    box-shadow: var(--sombra);

    transition: 0.3s;
}


.perfil-card:hover {

    transform: translateY(-8px);
}


.perfil-card img {

    width: 100%;

    height: 390px;

    object-fit: cover;

    object-position: center 35%;

    border-radius: 14px;

    display: block;
}


.perfil-info {

    padding: 16px 5px 5px;
}


.perfil-info strong,
.perfil-info span {

    display: block;
}


.perfil-info strong {

    color: var(--azul-escuro);

    font-family: "Poppins", sans-serif;

    font-size: 20px;
}


.perfil-info span {

    color: var(--texto-suave);

    font-size: 14px;
}


/* =========================================
   SEÇÕES
========================================= */

.secao {

    padding: 100px 10%;
}


.titulo {

    text-align: center;

    max-width: 700px;

    margin: 0 auto 55px;
}


.titulo p {

    color: var(--azul);

    font-size: 14px;

    font-weight: 700;

    letter-spacing: 2px;
}


.titulo h2 {

    font-size: 40px;

    color: var(--azul-escuro);

    margin-top: 5px;
}


/* =========================================
   SOBRE MIM
========================================= */

.sobre {

    background: var(--branco);
}


.sobre-grid {

    max-width: 1000px;

    margin: auto;

    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 25px;
}


.sobre-card {

    padding: 35px;

    border: 1px solid var(--borda);

    border-radius: 15px;

    background: var(--fundo);

    transition: 0.3s;
}


.sobre-card:hover {

    transform: translateY(-5px);

    box-shadow: var(--sombra);
}


.card-icone {

    font-size: 45px;

    margin-bottom: 15px;
}


.sobre-card h3 {

    color: var(--azul-escuro);

    font-size: 24px;

    margin-bottom: 15px;
}


.sobre-card p {

    color: var(--texto-suave);

    margin-bottom: 12px;
}


/* FOTO DA GASTRONOMIA */

.gastronomia-card {
    overflow: hidden;
}


.gastronomia-card img {

    width: 100%;

    height: 230px;

    object-fit: cover;

    border-radius: 12px;

    margin-bottom: 20px;

    display: block;
}


/* =========================================
   PROJETOS
========================================= */

.projetos-grid {

    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 25px;
}


.projeto-card {

    background: var(--branco);

    border: 1px solid var(--borda);

    border-radius: 15px;

    padding: 30px;

    transition: 0.3s;
}


.projeto-card:hover {

    transform: translateY(-8px);

    box-shadow: var(--sombra);
}


.projeto-topo {

    font-size: 45px;

    margin-bottom: 15px;
}


.projeto-card h3 {

    color: var(--azul-escuro);

    margin-bottom: 10px;
}


.projeto-card p {

    color: var(--texto-suave);

    margin-bottom: 20px;
}


.tecnologias {

    display: flex;

    flex-wrap: wrap;

    gap: 8px;

    margin-bottom: 20px;
}


.tecnologias span {

    background: #eaf1f8;

    color: var(--azul-escuro);

    padding: 5px 10px;

    border-radius: 20px;

    font-size: 13px;
}


.projeto-link {

    color: var(--azul);

    font-weight: 700;
}


/* =========================================
   HABILIDADES
========================================= */

.habilidades {

    background: var(--branco);
}


.habilidades-grid {

    max-width: 1000px;

    margin: auto;

    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 18px;
}


.habilidade {

    padding: 25px;

    background: var(--fundo);

    border: 1px solid var(--borda);

    border-radius: 12px;

    text-align: center;
}


.habilidade strong {

    display: block;

    color: var(--azul-escuro);

    font-family: "Poppins", sans-serif;

    font-size: 20px;
}


.habilidade span {

    color: var(--texto-suave);

    font-size: 14px;
}


/* =========================================
   CONTATO
========================================= */

.contato {

    text-align: center;
}


.contato-botoes {

    justify-content: center;
}


.contato-texto {

    color: var(--texto-suave);

    font-size: 18px;
}


/* =========================================
   RODAPÉ
========================================= */

.footer {

    padding: 25px;

    text-align: center;

    background: var(--azul-escuro);

    color: #ffffff;
}


.footer p {
    margin: 3px;
}


/* =========================================
   RESPONSIVIDADE
========================================= */

@media (max-width: 900px) {

    .header {
        padding: 18px 5%;
    }

    .hero {

        padding: 70px 7%;

        flex-direction: column;

        text-align: center;
    }

    .hero-botoes {
        justify-content: center;
    }

    .perfil-card {

        width: 100%;

        max-width: 360px;
    }

    .secao {
        padding: 80px 7%;
    }

    .projetos-grid {

        grid-template-columns: 1fr 1fr;
    }

    .habilidades-grid {

        grid-template-columns: 1fr 1fr;
    }
}


@media (max-width: 650px) {

    .header {

        flex-direction: column;

        gap: 15px;
    }

    .menu {

        gap: 15px;

        flex-wrap: wrap;

        justify-content: center;
    }

    .menu a {
        font-size: 14px;
    }

    .hero {

        min-height: auto;

        padding: 70px 6%;
    }

    .hero h1 {
        font-size: 48px;
    }

    .hero h2 {
        font-size: 22px;
    }

    .hero-texto {
        font-size: 16px;
    }

    .sobre-grid,
    .projetos-grid,
    .habilidades-grid {

        grid-template-columns: 1fr;
    }

    .titulo h2 {
        font-size: 30px;
    }

    .secao {
        padding: 70px 6%;
    }

    .perfil-card img {
        height: 430px;
    }
}